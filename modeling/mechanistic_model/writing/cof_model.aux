\newlabel{sec:onepool}{{6}{4}{The One-Pool Model (Pure Kinetic)}{section.6}{}}
\newlabel{eq:onepool_efficiency}{{8}{4}{The One-Pool Model (Pure Kinetic)}{equation.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Fitted parameters for the One-Pool model}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:onepool_params}{{3}{4}{Fitted parameters for the One-Pool model}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {One-Pool Model: Pure Kinetics Fails.} (A) Model fit shows the One-Pool model predicts decreasing efficiency with more domains, opposite to the experimental trend. (B) Schematic of the One-Pool model assuming all nascent chains are competent for folding. (C) Fitted parameter: $k_{\text  {fold}}= 0.0059$ s$^{-1}$ ($\tau _{\text  {fold}}= 171$ s). (D) Translation timeline showing the time windows for folding for each GFP domain.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:onepool_solution}{{2}{5}{\textbf {One-Pool Model: Pure Kinetics Fails.} (A) Model fit shows the One-Pool model predicts decreasing efficiency with more domains, opposite to the experimental trend. (B) Schematic of the One-Pool model assuming all nascent chains are competent for folding. (C) Fitted parameter: $\kfold = 0.0059$ s$^{-1}$ ($\taufold = 171$ s). (D) Translation timeline showing the time windows for folding for each GFP domain}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {One-Pool Model: Parameter Sensitivity.} Sensitivity of $\chi ^2$ (weighted MSE) to $\tau _{\text  {fold}}$ (30--250s). The dotted line marks the best-fit $\tau _{\text  {fold}} = 171$s that minimizes $\chi ^2$. }}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:onepool_params}{{3}{5}{\textbf {One-Pool Model: Parameter Sensitivity.} Sensitivity of $\chi ^2$ (weighted MSE) to $\tau _{\text {fold}}$ (30--250s). The dotted line marks the best-fit $\tau _{\text {fold}} = 171$s that minimizes $\chi ^2$}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}The Two-Pool Model}{6}{section.7}\protected@file@percent }
\newlabel{sec:twopool}{{7}{6}{The Two-Pool Model}{section.7}{}}
\newlabel{eq:twopool_efficiency}{{10}{6}{The Two-Pool Model}{equation.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Best-Fit Model: Two-Pool Results}{6}{subsection.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Fitted parameters for the Two-Pool model}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:twopool_params}{{4}{6}{Fitted parameters for the Two-Pool model}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Two-Pool Model.} (A)~Schematic of the Two-Pool model with foldable and non-foldable populations. The effective foldable fraction $f_{\text  {eff}} = f_{\text  {base}} + f_{\text  {gain}} \cdot (n_{\text  {GFP}} - 1)$ increases with the number of GFP domains (avidity effect). (B)~Model fit shows agreement with experimental data, correctly predicting the increasing efficiency trend with fitted parameters: $k_{\text  {fold}}= 0.014$~s$^{-1}$ ($\tau _{\text  {fold}}= 71$~s), $f_{\text  {base}} = 0.37$, $f_{\text  {gain}} = 0.14$.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:twopool_solution}{{4}{7}{\textbf {Two-Pool Model.} (A)~Schematic of the Two-Pool model with foldable and non-foldable populations. The effective foldable fraction $f_{\text {eff}} = f_{\text {base}} + f_{\text {gain}} \cdot (n_{\text {GFP}} - 1)$ increases with the number of GFP domains (avidity effect). (B)~Model fit shows agreement with experimental data, correctly predicting the increasing efficiency trend with fitted parameters: $\kfold = 0.014$~s$^{-1}$ ($\taufold = 71$~s), $f_{\text {base}} = 0.37$, $f_{\text {gain}} = 0.14$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Two-Pool Model: Parameter Space Analysis.} Pairwise 2D sweeps showing $\chi ^2$ (weighted MSE) as a function of parameter pairs (other parameters held at best-fit values). Dark regions indicate better fits (lower $\chi ^2$); red stars indicate best-fit values that minimize $\chi ^2$. (A) $\tau _{\text  {fold}}$ ($= 1/k_{\text  {fold}}$) vs $f_{\text  {base}}$. (B) $\tau _{\text  {fold}}$ ($= 1/k_{\text  {fold}}$) vs $f_{\text  {gain}}$. (C) $f_{\text  {base}}$ vs $f_{\text  {gain}}$.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:twopool_space}{{5}{7}{\textbf {Two-Pool Model: Parameter Space Analysis.} Pairwise 2D sweeps showing $\chi ^2$ (weighted MSE) as a function of parameter pairs (other parameters held at best-fit values). Dark regions indicate better fits (lower $\chi ^2$); red stars indicate best-fit values that minimize $\chi ^2$. (A) $\taufold $ ($= 1/\kfold $) vs $f_{\text {base}}$. (B) $\taufold $ ($= 1/\kfold $) vs $f_{\text {gain}}$. (C) $f_{\text {base}}$ vs $f_{\text {gain}}$}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Two-Pool Model: Parameter Sensitivity.} Sensitivity of $\chi ^2$ (weighted MSE) to each parameter while holding other parameters at best-fit values. Shaded regions indicate acceptable ranges ($\chi ^2 \leq 2\times $ best); dashed lines mark best-fit values. (A) $\tau _{\text  {fold}}$ sensitivity. (B) $f_{\text  {base}}$ sensitivity. (C) $f_{\text  {gain}}$ sensitivity.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:sensitivity}{{6}{8}{\textbf {Two-Pool Model: Parameter Sensitivity.} Sensitivity of $\chi ^2$ (weighted MSE) to each parameter while holding other parameters at best-fit values. Shaded regions indicate acceptable ranges ($\chi ^2 \leq 2\times $ best); dashed lines mark best-fit values. (A) $\tau _{\text {fold}}$ sensitivity. (B) $f_{\text {base}}$ sensitivity. (C) $f_{\text {gain}}$ sensitivity}{figure.caption.10}{}}
