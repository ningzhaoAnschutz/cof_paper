\newlabel{fig:twopool_slow_fit}{{7}{9}{\textbf {Two-Pool Model Fit to GFPuv Data.} Data points show individual cell measurements (gray) with mean $\pm $ SEM (black). Red crosses indicate Two-Pool model predictions. The model successfully captures the lower efficiencies and saturation behavior of the slower-folding GFPuv variant}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Two-Pool Model Parameter Space for GFPuv.} Pairwise 2D sweeps showing $\chi ^2$ as a function of parameter pairs (other parameters held at best-fit values). Red stars indicate best-fit values. (A)~$\tau _{\text  {fold}}$ vs $f_{\text  {base}}$. (B)~$\tau _{\text  {fold}}$ vs $f_{\text  {gain}}$. (C)~$f_{\text  {base}}$ vs $f_{\text  {gain}}$.}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:twopool_slow_space}{{8}{10}{\textbf {Two-Pool Model Parameter Space for GFPuv.} Pairwise 2D sweeps showing $\chi ^2$ as a function of parameter pairs (other parameters held at best-fit values). Red stars indicate best-fit values. (A)~$\taufold $ vs $f_{\text {base}}$. (B)~$\taufold $ vs $f_{\text {gain}}$. (C)~$f_{\text {base}}$ vs $f_{\text {gain}}$}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Two-Pool Model Parameter Sensitivity for GFPuv.} Sensitivity of $\chi ^2$ to each parameter while holding others at best-fit values. Shaded regions indicate acceptable ranges ($\chi ^2 \leq 2\times $ best); dashed lines mark best-fit values. (A)~$\tau _{\text  {fold}}$ sensitivity. (B)~$f_{\text  {base}}$ sensitivity. (C)~$f_{\text  {gain}}$ sensitivity.}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:twopool_slow_sensitivity}{{9}{10}{\textbf {Two-Pool Model Parameter Sensitivity for GFPuv.} Sensitivity of $\chi ^2$ to each parameter while holding others at best-fit values. Shaded regions indicate acceptable ranges ($\chi ^2 \leq 2\times $ best); dashed lines mark best-fit values. (A)~$\tau _{\text {fold}}$ sensitivity. (B)~$f_{\text {base}}$ sensitivity. (C)~$f_{\text {gain}}$ sensitivity}{figure.caption.15}{}}
